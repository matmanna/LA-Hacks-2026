{
  "name": "betterbill",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/server": "^1.15.6",
      "@orpc/client": "^1.15.6",
      "@orpc/openapi": "^1.15.6",
      "@orpc/zod": "^1.15.6",
      "better-auth": "1.7.7",
      "@polar-sh/better-auth": "^1.8.4",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @betterbill/db --",
    "db:studio": "turbo run db:studio -F @betterbill/db --",
    "db:generate": "turbo run db:generate -F @betterbill/db --",
    "db:migrate": "turbo run db:migrate -F @betterbill/db --",
    "db:seed": "turbo run db:seed -F @betterbill/db --",
    "deploy:setup": "bunx vercel link",
    "dev:vercel": "bunx vercel dev -L",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "deploy": "bunx vercel deploy",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:check": "bunx vercel deploy --dry",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "auth:generate": "cd apps/web && bun run auth:generate",
    "check": "biome check --write .",
    "fixtures:validate": "bun scripts/fixtures/validate.ts",
    "copy:check": "bun scripts/copy/check-wording.ts",
    "measure:letters": "bun --env-file=apps/web/.env packages/api/scripts/measure-letters.ts",
    "e2e": "playwright test",
    "data:gen": "bun scripts/gen-api-data.ts",
    "data:check": "bun scripts/gen-api-data.ts --check",
    "eval": "bun scripts/eval/run.ts",
    "eval:photos": "bun scripts/eval/run.ts --photos",
    "eval:all": "bun scripts/eval/run.ts --photos --botm",
    "photos:read": "bun scripts/read-photos.ts",
    "render:bills": "bun scripts/render/render.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@betterbill/config": "workspace:*",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.4.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.13",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.3.12"
}
