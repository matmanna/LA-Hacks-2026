{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/data/**"]
    },
    "test:integration": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    }
  },
  "globalEnv": [
    "BB_ADAPTER_KEY",
    "BB_FAKE_PROVIDERS",
    "BB_READER_MODE",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CALL_ALLOWLIST",
    "CI",
    "DATABASE_URL",
    "DEMO_CALL_FALLBACK",
    "ELEVENLABS_AGENT_ID",
    "ELEVENLABS_API_KEY",
    "ELEVENLABS_PHONE_NUMBER_ID",
    "EMAIL_ALLOWLIST",
    "EMAIL_FROM",
    "EMAIL_PROVIDER",
    "EMAIL_TEST_INBOX",
    "GEMINI_API_KEY",
    "GEMINI_MODEL",
    "NODE_ENV",
    "POLAR_ACCESS_TOKEN",
    "POLAR_SUCCESS_URL",
    "RESEND_API_KEY",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "STEPFUN_API_KEY",
    "STEPFUN_BASE_URL",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_URL",
    "VITE_SENTRY_DSN",
    "_VARLOCK_ENV_KEY"
  ],
  "globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
