# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false
VERCEL_ENV=

# @internal @required=false
VERCEL_URL=

# @internal @required=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=$VERCEL_ORIGIN

# Optional: Polar is only needed for the paid "assisted call" tier.
# @required=false @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @required=false @type=url
POLAR_SUCCESS_URL=

# @type=string(minLength=1)
DATABASE_URL=

# Bill reader (B). Required once bill.parsePhoto is live.
# @required=false @type=string(minLength=1)
STEPFUN_API_KEY=

# Optional override. Docs list https://api.stepfun.ai/v1 (the default).
# @required=false @sensitive=false @type=url
STEPFUN_BASE_URL=

# Letters and text cleanup (A, B).
# @required=false @type=string(minLength=1)
GEMINI_API_KEY=

# Letter drafting model (A). Defaults to gemini-3.8-flash.
# @required=false @sensitive=false @type=string(minLength=1)
GEMINI_MODEL=

# Where drafted letters are addressed in the demo (A). Defaults to the hospital's billing office.
# @required=false @type=email
EMAIL_TEST_INBOX=

# Sending approved letters (A). Resend is the only provider wired.
# @required=false @sensitive=false @type=enum(resend)
EMAIL_PROVIDER=resend

# @required=false @type=string(minLength=1)
RESEND_API_KEY=

# Sender, e.g. "BetterBill <onboarding@resend.dev>".
# @required=false @sensitive=false @type=string(minLength=3)
EMAIL_FROM=

# Comma-separated addresses the demo may send to. Empty means nothing is sent.
# @required=false
EMAIL_ALLOWLIST=

# 1 only in tests: email and call providers return fake ids, labelled "fake".
# @required=false @sensitive=false @type=enum(0, 1)
BB_FAKE_PROVIDERS=

# Outbound call (A). ElevenLabs dials through the Photon SIP trunk.
# @required=false @type=string(minLength=1)
ELEVENLABS_API_KEY=

# @required=false @sensitive=false @type=string(minLength=1)
ELEVENLABS_AGENT_ID=

# The Photon number imported into ElevenLabs.
# @required=false @sensitive=false @type=string(minLength=1)
ELEVENLABS_PHONE_NUMBER_ID=

# Comma-separated E.164 numbers of people who agreed to take a test call.
# The first is the "billing office" phone. Empty means no calls.
# @required=false
CALL_ALLOWLIST=

# 1 shows the recorded rehearsal call (clearly labelled) if the live call fails.
# @required=false @sensitive=false @type=enum(0, 1)
DEMO_CALL_FALLBACK=

# Sentry (B). DSNs are not secrets; the auth token is build-time only.
# @required=false @sensitive=false @type=url
SENTRY_DSN=

# @public @required=false @type=url
VITE_SENTRY_DSN=

# @required=false @type=string(minLength=1)
SENTRY_AUTH_TOKEN=

# live | cache_first | cache_only
# @required=false @sensitive=false @type=enum(live, cache_first, cache_only)
BB_READER_MODE=live

# Shared secret for the Fetch adapter (x-bb-adapter-key header).
# @required=false @type=string(minLength=16)
BB_ADAPTER_KEY=
