# Copy to apps/web/.env (the app and packages/db read env through varlock schemas:
# apps/web/.env.schema and packages/db/.env.schema). Names only, never commit values.
NODE_ENV=development
DATABASE_URL=postgres://bb:bb@localhost:5432/betterbill
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
POLAR_ACCESS_TOKEN=
POLAR_SUCCESS_URL=
# sandbox (default) | production. Use a sandbox token for the demo.
POLAR_SERVER=sandbox
# Polar product ids (not secrets)
POLAR_SAVINGS_PRODUCT_ID=
POLAR_BULK_PRODUCT_ID=
# sandbox only: savings fee becomes 50 cents with this code
POLAR_DEV_PROMO_CODE=
STEPFUN_API_KEY=
# optional; default https://api.stepfun.ai/v1
STEPFUN_BASE_URL=
GEMINI_API_KEY=
# optional; default gemini-3.8-flash
GEMINI_MODEL=
# optional; where drafted letters are addressed in the demo
EMAIL_TEST_INBOX=
# sending approved letters through Photon
EMAIL_PROVIDER=photon
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Bare email address on a verified domain connected to the Photon project.
EMAIL_FROM=
# comma-separated; only these addresses can receive
EMAIL_ALLOWLIST=
# 1 only in tests
BB_FAKE_PROVIDERS=
# outbound call (ElevenLabs dialing through the Photon SIP trunk)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional; selects the same agent branch as an ElevenLabs talk-to link.
ELEVENLABS_BRANCH_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# comma-separated E.164 numbers of consenting test phones; first = billing office
CALL_ALLOWLIST=
# 1 shows the labelled recorded rehearsal call if the live call fails
DEMO_CALL_FALLBACK=
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
# live | cache_first | cache_only
BB_READER_MODE=live
# shared secret for the Fetch adapter
BB_ADAPTER_KEY=
# true = approve/send/call need a real account (B-11)
BB_REQUIRE_ACCOUNT=false
BROWSER_USE_API_KEY=

# Patient-first advocate calls. Both recipients must consent and be allowlisted.
# Keep direct until the LiveKit controller is running and these are configured.
CALL_MODE=direct
CALL_PATIENT_NUMBER=
# 1 = dial any well-formed number entered on the phone page (test phones only!)
CALL_ALLOW_USER_NUMBERS=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_PHOTON_TRUNK_ID=
ELEVENLABS_CONFERENCE_BRANCH_ID=
# Optional included voice for the patient introduction when the agent voice needs paid API access.
ELEVENLABS_INVITATION_VOICE_ID=
BB_VOICE_WORKER_KEY=
# Local controller: http://localhost:3001. Cloud controller: your deployed API origin.
BETTERBILL_VOICE_API_URL=
